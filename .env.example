# =============================================================================
# The Negotiator — environment template.
#   cp .env.example .env   then fill in the secrets below.
# .env itself is gitignored — NEVER commit real keys.
# =============================================================================

# --- OpenAI — text-mode negotiation sim (sim/negotiate.py) -------------------
OPENAI_API_KEY=sk-REPLACE_ME            # <-- paste your OpenAI key
CALLER_MODEL=gpt-4.1                     # optional (default shown)
PERSONA_MODEL=gpt-4o-mini                # optional (default shown)

# --- ElevenLabs — voice agents (elevenlabs/create_agents.py) -----------------
ELEVENLABS_API_KEY=sk_REPLACE_ME         # <-- paste your ElevenLabs key

# --- Anthropic — intake vision extraction (backend/intake_router.py) ---------
# NOTE: intake uses CLAUDE vision, which needs an Anthropic key — that's
# separate from your OpenAI credits. No Anthropic key? Ask me to switch the
# vision extraction to OpenAI (gpt-4o) so it runs on your OpenAI credits.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME      # <-- paste your Anthropic key (or switch to OpenAI)
INTAKE_MODEL=claude-opus-4-8             # optional override

# --- Supabase — backend writes (intake_router + Umra's app) ------------------
SUPABASE_URL=https://bhwtkatjwaduxbicdaur.supabase.co
# service_role SECRET — grab from the dashboard (not exposed by tooling):
#   Settings > API > service_role
#   https://supabase.com/dashboard/project/bhwtkatjwaduxbicdaur/settings/api
SUPABASE_SERVICE_KEY=REPLACE_ME

# =============================================================================
# FRONTEND lives in frontend/the-negotiator/.env.local (Next.js — its OWN file).
# Create that file with:
#   NEXT_PUBLIC_SUPABASE_URL=https://bhwtkatjwaduxbicdaur.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_JzdWK7DXtbU5AeZE87LZ-A_6njP3x4N
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # backend base once it's running
#   NEXT_PUBLIC_USE_MOCKS=true                         # flip to false when backend is live
# The anon/publishable key above is safe to ship (RLS-protected). The
# service_role key must NEVER appear in frontend code.
# =============================================================================
